# ===== Sao chép file này thành ".env" ở THƯ MỤC GỐC (cùng cấp với docker-compose.yml) =====
#   Windows (CMD/PowerShell):  copy .env.example .env
#   macOS / Linux / Git Bash:  cp .env.example .env
# Một file .env dùng chung cho Docker, Backend và Frontend. KHÔNG commit file .env lên git.

# ---------------- Backend (NestJS) ----------------
PORT=3000
NODE_ENV=development
# Các địa chỉ FE được phép gọi API (cách nhau bằng dấu phẩy)
CORS_ORIGIN=http://localhost:5173

# ---------------- SQL Server ----------------
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
# Docker dùng chính mật khẩu này cho tài khoản sa. Nếu cài SQL Server trực tiếp thì điền mật khẩu của bạn.
# (>= 8 ký tự, gồm chữ hoa, chữ thường, số, ký tự đặc biệt)
DB_PASSWORD=QLKho@2026
DB_NAME=QuanLyKhoPhuKien
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# true: TypeORM tự đồng bộ bảng theo entity (chỉ để thử nghiệm; nhóm dùng script SQL nên để false)
DB_SYNCHRONIZE=false

# ---------------- JWT (đăng nhập) ----------------
JWT_SECRET=doi-chuoi-bi-mat-nay-trong-file-env-that
JWT_EXPIRES_IN=1d

# ---------------- Frontend (React + Vite) ----------------
# Chỉ biến bắt đầu bằng VITE_ mới được đưa ra trình duyệt
VITE_API_URL=http://localhost:3000/api
