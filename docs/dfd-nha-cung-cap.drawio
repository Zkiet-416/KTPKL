        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Admin[Quản lý kho / Thủ kho]\n    Sys((0.0 Hệ thống Quản lý \\nNhà Cung Cấp))\n\n    Admin -- Yêu cầu Cập nhật, Tìm kiếm, Thống kê --&gt; Sys\n    Sys -- Thông báo kết quả, Danh sách, Báo cáo --&gt; Admin\n\nflowchart TD\n    Admin[Quản lý kho / Thủ kho]\n    D1[(Kho: Suppliers)]\n    D2[(Kho: GoodsReceipts)]\n\n    P1((1.0 Cập nhật \\nthông tin))\n    P2((2.0 Tra cứu \\n&amp; Tìm kiếm))\n    P3((3.0 Thống kê \\n&amp; Báo cáo))\n\n    %% Luồng 1.0\n    Admin -- Thông tin NCC, Yêu cầu Xóa --&gt; P1\n    P1 -- Thông báo kết quả --&gt; Admin\n    P1 -- Ghi nhận / Xóa / Cập nhật --&gt; D1\n\n    %% Luồng 2.0\n    Admin -- Từ khóa (ID, Tên, Email) --&gt; P2\n    P2 -- Danh sách kết quả --&gt; Admin\n    P2 -- Lệnh truy vấn --&gt; D1\n    D1 -- Trả dữ liệu NCC --&gt; P2\n\n    %% Luồng 3.0\n    Admin -- Yêu cầu thống kê --&gt; P3\n    P3 -- Báo cáo, Biểu đồ --&gt; Admin\n    P3 -- Truy xuất thông tin --&gt; D1\n    P3 -- Đối chiếu lịch sử nhập --&gt; D2\n\nflowchart TD\n    Admin[Quản lý kho / Thủ kho]\n    D1[(Kho: Suppliers)]\n    D2[(Kho: GoodsReceipts)]\n\n    P11((1.1 Kiểm tra \\ntính hợp lệ))\n    P12((1.2 Ghi nhận \\nThêm / Sửa))\n    P13((1.3 Kiểm tra \\nràng buộc Xóa))\n    P14((1.4 Thực thi \\nXóa / Ngừng HĐ))\n\n    Admin -- Thông tin NCC mới/sửa --&gt; P11\n    P11 -- Truy vấn Email, SĐT --&gt; D1\n    D1 -- Kết quả trùng lặp --&gt; P11\n    P11 -- Dữ liệu sạch --&gt; P12\n    P11 -- Báo lỗi trùng lặp --&gt; Admin\n    P12 -- Lưu thay đổi --&gt; D1\n    P12 -- Báo thành công --&gt; Admin\n\n    Admin -- Yêu cầu xóa (Kèm ID) --&gt; P13\n    P13 -- Đối chiếu mã NCC --&gt; D2\n    D2 -- Lịch sử phiếu nhập --&gt; P13\n    P13 -- Quyết định Xóa cứng/mềm --&gt; P14\n    P14 -- Xóa / Đổi trạng thái --&gt; D1\n    P14 -- Báo kết quả --&gt; Admin\n\nflowchart TD\n    Admin[Quản lý kho / Thủ kho]\n    D1[(Kho: Suppliers)]\n\n    P21((2.1 Tiếp nhận \\ntiêu chí lọc))\n    P22((2.2 Truy vấn \\ndữ liệu))\n    P23((2.3 Sắp xếp \\n&amp; Định dạng))\n\n    Admin -- Từ khóa, Tiêu chí (A-Z, Mới nhất) --&gt; P21\n    P21 -- Lệnh tìm kiếm --&gt; P22\n    P22 -- Truy vấn --&gt; D1\n    D1 -- Dữ liệu thô --&gt; P22\n    P22 -- Kết quả thô --&gt; P23\n    P23 -- Danh sách hoàn chỉnh --&gt; Admin\n\nflowchart TD\n    Admin[Quản lý kho / Thủ kho]\n    D1[(Kho: Suppliers)]\n    D2[(Kho: GoodsReceipts)]\n\n    P31((3.1 Tiếp nhận \\nyêu cầu))\n    P32((3.2 Tổng hợp \\nNCC &amp; Giao dịch))\n    P33((3.3 Tính toán \\n&amp; Lập báo cáo))\n\n    Admin -- Mốc thời gian, Tiêu chí --&gt; P31\n    P31 -- Lệnh trích xuất --&gt; P32\n    P32 -- Lấy danh sách NCC --&gt; D1\n    P32 -- Lấy lịch sử nhập --&gt; D2\n    D1 -- Dữ liệu NCC --&gt; P32\n    D2 -- Dữ liệu Phiếu nhập --&gt; P32\n    P32 -- Dữ liệu tổng hợp --&gt; P33\n    P33 -- Báo cáo thống kê --&gt; Admin&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="hKnS8AueIn0qXfGMBjx8-19">
