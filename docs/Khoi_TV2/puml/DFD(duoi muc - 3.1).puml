@startuml DFD_311_ProductMaintenance

top to bottom direction
skinparam shadowing false

rectangle "Quản lý kho" as Manager

circle "3.1.1\nThêm mới\nsản phẩm" as P311
circle "3.1.2\nChỉnh sửa\nsản phẩm" as P312
circle "3.1.3\nXóa / Vô\nhiệu hóa" as P313

database "D1\nDanh mục sản phẩm" as D1
database "D2\nSản phẩm" as D2

'======================
' 3.1.1 THÊM MỚI SẢN PHẨM
'======================

Manager --> P311 : Thông tin sản phẩm mới\n(Tên, giá,...)

D1 --> P311 : Danh mục sản phẩm

P311 --> D2 : Thông tin sản phẩm mới

P311 --> Manager : Thông báo thêm thành công


'======================
' 3.1.2 CHỈNH SỬA SẢN PHẨM
'======================

Manager --> P312 : Thông tin cập nhật sản phẩm

D2 --> P312 : Thông tin sản phẩm hiện tại

D1 --> P312 : Danh mục sản phẩm

P312 --> D2 : Thông tin sản phẩm cập nhật

P312 --> Manager : Thông báo sửa thành công


'======================
' 3.1.3 XÓA / VÔ HIỆU HÓA
'======================

Manager --> P313 : Yêu cầu xóa\nhoặc tắt kích hoạt sản phẩm

D2 --> P313 : Thông tin tồn kho\nvà trạng thái sản phẩm

P313 --> D2 : Trạng thái sản phẩm cập nhật

P313 --> Manager : Thông báo kết quả xóa

@enduml