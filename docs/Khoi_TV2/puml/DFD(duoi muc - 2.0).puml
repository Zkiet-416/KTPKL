@startuml DFD_Level2_Category

top to bottom direction
skinparam shadowing false

rectangle "Quản lý kho" as Manager

circle "2.1\nThêm loại\nsản phẩm" as P21
circle "2.2\nSửa loại\nsản phẩm" as P22
circle "2.3\nXóa loại\nsản phẩm" as P23
circle "2.4\nXem danh sách\ndanh mục" as P24

database "D1\nDanh mục sản phẩm" as D1
database "D2\nSản phẩm" as D2

'=========================
' 2.1 THÊM LOẠI SẢN PHẨM
'=========================
Manager --> P21 : Thông tin loại SP mới
P21 --> Manager : Thông báo kết quả thêm

P21 --> D1 : Ghi thêm loại SP mới
D1 --> P21 : Kiểm tra trùng tên loại SP

'=========================
' 2.2 SỬA LOẠI SẢN PHẨM
'=========================
Manager --> P22 : Thông tin cập nhật loại SP
P22 --> Manager : Thông báo kết quả sửa

D1 --> P22 : Dữ liệu loại SP hiện tại
P22 --> D1 : Ghi cập nhật loại SP

'=========================
' 2.3 XÓA LOẠI SẢN PHẨM
'=========================
Manager --> P23 : Yêu cầu xóa loại SP
P23 --> Manager : Thông báo kết quả xóa

D1 --> P23 : Danh sách loại SP
P23 --> D1 : Ghi lệnh xóa loại SP

D2 --> P23 : Kiểm tra ràng buộc sản phẩm

'=========================
' 2.4 XEM DANH MỤC
'=========================
Manager --> P24 : Yêu cầu xem danh mục
P24 --> Manager : Danh sách loại sản phẩm

D1 --> P24 : Toàn bộ danh sách loại SP

@enduml