@startuml DFD_Level1

top to bottom direction
skinparam shadowing false

rectangle "Quản lý / Admin" as Admin
rectangle "Nhân viên kho" as Staff

circle "1.0\nQuản lý\nTổng quan" as P1
circle "2.0\nQuản lý\nDanh mục" as P2
circle "3.0\nQuản lý\nSản phẩm" as P3

database "D1\nCategories" as D1
database "D2\nProducts" as D2
database "D3\nOrders / Sales" as D3

Admin --> P1 : Yêu cầu thống kê
P1 --> Admin : Báo cáo tồn kho\nDoanh thu

Admin --> P2 : Thêm/Sửa/Xóa loại SP
P2 --> Admin : Kết quả cập nhật danh mục

Admin --> P3 : Thêm/Sửa/Xóa sản phẩm
P3 --> Admin : Kết quả cập nhật SP

Staff --> P3 : Yêu cầu tra cứu\nSắp xếp
P3 --> Staff : Danh sách kết quả\nChi tiết SP

D3 --> P1 : Dữ liệu doanh thu
D2 --> P1 : Dữ liệu tồn kho

P2 --> D1 : Ghi/Cập nhật loại SP
D1 --> P2 : Thông tin loại SP

D1 --> P3 : Danh mục phân loại

P3 --> D2 : Ghi/Cập nhật SP
D2 --> P3 : Thông tin SP

@enduml