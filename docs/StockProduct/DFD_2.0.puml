@startuml DFD_2.0
title DFD mức 1 - Tiến trình 2.0 Quản lý sản phẩm

left to right direction
skinparam shadowing false
skinparam rectangle {
  BackgroundColor #FFF2CC
  BorderColor #BF9000
}
skinparam usecase {
  BackgroundColor #DAE8FC
  BorderColor #2F5597
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

' ===== Tác nhân ngoài =====
rectangle "Quản lý kho" as QLK

' ===== Tiến trình =====
usecase "2.1\nQuản lý\nloại sản phẩm" as P1
usecase "2.2\nQuản lý sản phẩm\n(thêm, sửa, xóa)" as P2
usecase "2.3\nTìm kiếm, sắp xếp\nsản phẩm" as P3
usecase "2.4\nTổng quan\n(Tồn kho, Doanh thu)" as P4

' ===== Kho dữ liệu =====
database "Categories\n(Loại sản phẩm)" as D2
database "Products\n(Sản phẩm)" as D3
database "Phiếu nhập kho" as D5
database "Phiếu xuất kho" as D6

' ===== 2.1 Quản lý loại sản phẩm =====
QLK --> P1 : Thông tin loại sản phẩm\n(thêm, sửa, xóa)
P1 --> QLK : Danh sách loại sản phẩm,\nkết quả thao tác
P1 --> D2 : Loại sản phẩm mới /\nđã sửa / đã xóa
D2 --> P1 : Danh sách loại sản phẩm
D3 --> P1 : Kiểm tra sản phẩm\nthuộc loại

' ===== 2.2 Quản lý sản phẩm =====
QLK --> P2 : Thông tin sản phẩm\n(thêm, sửa, xóa)
P2 --> QLK : Kết quả thao tác /\nthông báo lỗi
P2 --> D3 : Thêm, sửa, xóa\nsản phẩm
D3 --> P2 : Thông tin sản phẩm hiện tại
D2 --> P2 : Danh sách loại sản phẩm
D5 --> P2 : Kiểm tra sản phẩm\ntrong phiếu nhập
D6 --> P2 : Kiểm tra sản phẩm\ntrong phiếu xuất

' ===== 2.3 Tìm kiếm, sắp xếp sản phẩm =====
QLK --> P3 : Từ khóa, loại sản phẩm,\ntiêu chí sắp xếp
D3 --> P3 : Danh sách sản phẩm
D2 --> P3 : Tên loại sản phẩm
P3 --> QLK : Danh sách sản phẩm\nđã tìm / sắp xếp

' ===== 2.4 Tổng quan =====
QLK --> P4 : Yêu cầu xem tổng quan
D3 --> P4 : Số lượng tồn,\ngiá bán sản phẩm
D6 --> P4 : Số lượng xuất,\ngiá bán các phiếu xuất
P4 --> QLK : Tổng sản phẩm tồn kho,\ntổng doanh thu
@enduml